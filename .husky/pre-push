echo "Running pre-push checks..."

# Read-only format/lint check (Biome, ~15s). Do not use --write here: the
# commits being pushed are already fixed, so auto-fixing would only mutate the
# working tree without changing what gets pushed.
if ! bunx biome check .; then
  echo "❌ Biome check failed. Run 'bun run check' to auto-fix, then commit."
  exit 1
fi

echo "✅ Pre-push checks passed!"
echo ""
echo "Reminder: run these locally or rely on CI before merging:"
echo "  bun run typecheck"
echo "  bun run lint"
echo "  bun run test:unit"
echo "  bun run build"
