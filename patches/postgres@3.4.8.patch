diff --git a/cf/polyfills.js b/cf/polyfills.js
index 53c5203dd5b057d741d14d708ba83b27751b527c..cd6b7d5010fd9f907eef06b7bd5b6b18c5bb2368 100644
--- a/cf/polyfills.js
+++ b/cf/polyfills.js
@@ -184,6 +184,7 @@ function Socket() {
   }
 
   function end(data) {
+    tcp.ending = true
     return data
       ? tcp.write(data, () => tcp.raw.close())
       : tcp.raw.close()
@@ -206,11 +207,18 @@ function Socket() {
   }
 
   async function readFirst() {
-    const { value } = await tcp.reader.read()
-    tcp.emit('data', Buffer.from(value))
+    try {
+      const { done, value } = await tcp.reader.read()
+      if (!done) tcp.emit('data', Buffer.from(value))
+    } catch (err) {
+      error(err)
+    }
   }
 
   function error(err) {
+    // workerd rejects an outstanding read when close() shuts down the socket.
+    // An intentional shutdown is a close event, not a query failure.
+    if (tcp.ending) return close()
     tcp.emit('error', err)
     tcp.emit('close')
   }
